        choice=$("$DIALOG_BIN" --clear --backtitle "$PROGRAM $VERSION - inventory and local audit" \
            --title "slackaudit" \
            --menu "Choose a section. Collection does not change system settings." 20 84 12 \
            audit "Local audit summary" \
            requirements "Required tools and packages" \
            overview "System overview" \
            hardware "Hardware inventory" \
            packages "Installed packages" \
            storage "Storage and filesystems" \
            boot "Boot and kernel" \
            network "Network configuration" \
            services "Services and processes" \
            security "Local security configuration" \
            logs "Logs and diagnostics" \
            export "Write complete text report" \
            3>&1 1>&2 2>&3) || break
        case "$choice" in
            audit) show_section "Local audit summary" audit_summary ;;
            requirements) show_section "Required and optional packages" requirements_audit ;;
            overview) show_section "System overview" system_overview ;;
            hardware) hardware_menu ;;
            packages) packages_menu ;;
            storage) storage_menu ;;
            boot) boot_menu ;;
            network) network_menu ;;
            services) services_menu ;;
            security) security_menu ;;
            logs) logs_menu ;;
            export) export_dialog ;;
        esac
    done
    "$DIALOG_BIN" --clear
}
if [[ $EUID -ne 0 ]]; then
    "$DIALOG_BIN" --yesno "For the most complete audit, run as root (for example, sudo slackaudit). Continue with limited access?" 9 76 || exit 0
fi
main_menu
