security_accounts() { section_title "Local users and groups"; [[ -r /etc/passwd ]] && awk -F: '$3==0 || $3>=1000 {printf "%-20s uid=%-6s gid=%-6s home=%s shell=%s\n",$1,$3,$4,$6,$7}' /etc/passwd; printf '\nAdministrative groups:\n'; [[ -r /etc/group ]] && grep -E '^(wheel|sudo|root):' /etc/group || true; }
security_permissions() { local f; section_title "Sensitive file permissions"; for f in /etc/passwd /etc/shadow /etc/group /etc/sudoers /etc/ssh/sshd_config; do [[ -e "$f" ]] && stat -c '%A %a %U:%G %n' "$f" 2>&1; done; }
security_ssh() {
    local config=/etc/ssh/sshd_config effective="$TMPDIR_AUDIT/sshd-effective.out" test_key="$TMPDIR_AUDIT/sshd-audit-hostkey"
    section_title "SSH server configuration"
    if ! have sshd; then printf 'OpenSSH server command (sshd) is not installed. Install the Slackware openssh package to audit server settings.\n'; return; fi
    printf 'OpenSSH server command: %s\n' "$(command -v sshd)"
    if [[ -x /etc/rc.d/rc.sshd ]]; then printf 'Slackware rc.sshd: enabled (executable)\n'; elif [[ -e /etc/rc.d/rc.sshd ]]; then printf 'Slackware rc.sshd: disabled (not executable)\n'; else printf 'Slackware rc.sshd: script not found\n'; fi
    if have pgrep && pgrep -a sshd 2>/dev/null; then :; else printf 'Running sshd process: not detected\n'; fi
    if [[ ! -r "$config" ]]; then printf '\nServer configuration file not readable: %s\n' "$config"; return; fi
    printf '\nConfigured directives and include statements:\n'
    grep -E -i '^[[:space:]]*(Include|Port|ListenAddress|AddressFamily|PermitRootLogin|PasswordAuthentication|PubkeyAuthentication|KbdInteractiveAuthentication|PermitEmptyPasswords|AllowUsers|AllowGroups|DenyUsers|DenyGroups|AuthenticationMethods|MaxAuthTries|X11Forwarding|AllowTcpForwarding|UsePAM)[[:space:]]' "$config" | redact || printf 'No explicit matching directives; daemon defaults may apply.\n'
    if have sshd; then
        # sshd -T refuses to run without host keys. Create a disposable key
        # inside the private audit temp directory; never write to /etc/ssh.
        if have ssh-keygen && ssh-keygen -q -t ed25519 -N '' -f "$test_key" >/dev/null 2>&1; then
            if sshd -T -f "$config" -o "HostKey=$test_key" > "$effective" 2>&1; then
                printf '\nEffective global settings from sshd -T:\n'
                grep -E -i '^(port|addressfamily|listenaddress|permitrootlogin|passwordauthentication|pubkeyauthentication|kbdinteractiveauthentication|permitemptypasswords|allowusers|allowgroups|denyusers|denygroups|authenticationmethods|maxauthtries|x11forwarding|allowtcpforwarding|usepam) ' "$effective" | redact
            else
                printf '\nCould not calculate effective settings with sshd -T:\n'; cat "$effective" | redact
            fi
        elif sshd -T -f "$config" > "$effective" 2>&1; then
            printf '\nEffective global settings from sshd -T:\n'
            grep -E -i '^(port|addressfamily|listenaddress|permitrootlogin|passwordauthentication|pubkeyauthentication|kbdinteractiveauthentication|permitemptypasswords|allowusers|allowgroups|denyusers|denygroups|authenticationmethods|maxauthtries|x11forwarding|allowtcpforwarding|usepam) ' "$effective" | redact
        else
            printf '\nCould not calculate effective settings with sshd -T:\n'; cat "$effective" | redact
        fi
    fi
    printf '\nsshd -T reports global defaults. Match blocks can change settings for a particular user, host, or address.\n'
}
security_firewall() { section_title "Firewall rules"; if have nft; then nft list ruleset 2>&1 | redact; elif have iptables; then iptables -S 2>&1 | redact; else printf 'Install nftables or iptables to inspect firewall rules.\n'; fi; }
categorize_log_file() {
    local input=$1 tagged="$TMPDIR_AUDIT/tagged.log" category count
    awk '
        {
            line = tolower($0)
            if (line ~ /(^|[^[:alpha:]])(error|failed|failure|critical|crit:|panic|fatal|alert|emerg|segfault|oops|bug:|i\/o error|not found|not ready|not loaded|unable to|cannot|no such device)([^[:alpha:]]|$)/) { print "ERROR    " $0; next }
            if (line ~ /warn(ing)?|degraded|timed out|timeout|retry|overheat|throttl/) { print "WARNING  " $0; next }
            if (line ~ /(^|[^[:alnum:]])(ok|success(fully)?|started|ready|loaded|initialized|mounted)([^[:alnum:]]|$)/) { print "OK       " $0; next }
            print "INFO     " $0
        }
    ' "$input" > "$tagged"
    for category in ERROR WARNING OK INFO; do
        count=$(grep -c "^${category}[[:space:]]" "$tagged" 2>/dev/null || true)
        printf '\n%s messages: %s\n' "$category" "${count:-0}"
        if ((count > 0)); then grep "^${category}[[:space:]]" "$tagged" | tail -n 50 | redact; fi
    done
}
logs_kernel() {
    local raw="$TMPDIR_AUDIT/kernel-log.raw"
    section_title "Kernel messages by category"
    if ! have dmesg; then printf 'dmesg is unavailable. Install util-linux.\n'; return; fi
    if ! dmesg -T > "$raw" 2>&1; then printf 'Kernel buffer was not readable; run as root. Diagnostic:\n'; sed -n '1,5p' "$raw" | redact; return; fi
    printf 'Reviewing the current kernel buffer. Up to 50 recent lines per category are shown.\n'
    categorize_log_file "$raw"
}
logs_files() {
    local f raw="$TMPDIR_AUDIT/system-log.raw" found=0
    section_title "System log messages by category"
    for f in /var/log/messages /var/log/syslog /var/log/boot.log /var/log/secure /var/log/maillog /var/log/cron /var/log/debug; do
        [[ -r "$f" ]] || continue
        found=1
        printf '\n--- %s (last 1000 lines, categorized) ---\n' "$f"
        tail -n 1000 "$f" > "$raw"
        categorize_log_file "$raw"
    done
    ((found)) || printf 'No supported readable log files found.\n'
}

make_report() {
    local dest=$1 dir
    dir=${dest%/*}
    [[ "$dir" == "$dest" ]] && dir=.
    [[ -d "$dir" ]] || { printf 'Directory not found: %s\n' "$dir" >&2; return 1; }
    [[ ! -e "$dest" || $FORCE -eq 1 ]] || { printf 'File already exists; use --force: %s\n' "$dest" >&2; return 1; }
    {
        printf 'slackaudit %s - local audit report\n' "$VERSION"
        printf 'Generated at: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"
        printf 'Read-only report; may contain local information.\n\n'
        audit_summary
        system_overview
        hardware_all
        package_audit
        package_list
        requirements_audit
        storage_audit
        boot_audit
        network_audit
        services_audit
        security_audit
        logs_audit
    } > "$dest" 2>&1
    chmod 600 "$dest" 2>/dev/null || true
    printf 'Report written: %s\n' "$dest"
}

