package_missing_files() {
    local f n checked=0 missing=0
    local missingfile="$TMPDIR_AUDIT/missing-paths"; : > "$missingfile"
    section_title "Missing paths from package manifests"
    if [[ ! -d "$PACKAGE_LOG_DIR" ]]; then printf 'Package database directory not found: %s\n' "$PACKAGE_LOG_DIR"; return; fi
    shopt -s nullglob; local files=("$PACKAGE_LOG_DIR"/*); shopt -u nullglob
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        while IFS= read -r n; do
            [[ -n "$n" ]] || continue; [[ "$n" == install/* || "$n" == ./install/* ]] && continue
            case "$n" in ./*) n=${n#./} ;; esac; [[ "$n" == /* ]] || n="/$n"; ((checked+=1))
            if [[ ! -e "$n" && ! -L "$n" ]]; then ((missing+=1)); ((missing <= 200)) && printf '%s: %s\n' "$(basename "$f")" "$n" >> "$missingfile"; fi
        done < <(awk 'BEGIN{list=0} /^FILE LIST:/{list=1; next} list{print}' "$f")
    done
    printf 'Entries checked: %s\nMissing paths: %s\n' "$checked" "$missing"
    if ((missing)); then printf '\nFirst missing paths (maximum 200):\n'; cat "$missingfile"; fi
    printf '\nThis check does not compare file contents or hashes.\n'
}
storage_mounts() { section_title "Mounted filesystems"; if have findmnt; then findmnt -r -o TARGET,SOURCE,FSTYPE,OPTIONS 2>&1 | redact; else print_cmd df -hT; fi; }
storage_fstab() { section_title "/etc/fstab"; if [[ -r /etc/fstab ]]; then awk '!/^[[:space:]]*#/ && NF' /etc/fstab | redact; else printf '/etc/fstab unavailable.\n'; fi; if have findmnt; then printf '\nValidation:\n'; findmnt --verify --verbose --tab-file /etc/fstab 2>&1 | redact; fi; }
storage_usage() { section_title "Filesystem capacity and inodes"; print_cmd df -hT; printf '\nInodes:\n'; print_cmd df -hi; }
storage_smart() {
    local device type result="$TMPDIR_AUDIT/smartctl.out" count=0 rc
    section_title "SMART health checks"
    if ! have smartctl; then printf 'smartmontools (smartctl) is not installed. Install it to query disk health.\n'; return; fi
    if [[ $EUID -ne 0 ]]; then printf 'Run as root to query SMART status for all detected disks.\n'; return; fi
    if ! have lsblk; then printf 'util-linux (lsblk) is required to safely identify whole-disk devices.\n'; return; fi
    while read -r device type; do
        [[ "$type" == disk && -b "$device" ]] || continue
        ((count+=1))
        printf '\n--- %s ---\n' "$device"
        if have timeout; then timeout 20s smartctl -H "$device" > "$result" 2>&1; rc=$?
        else smartctl -H "$device" > "$result" 2>&1; rc=$?; fi
        redact < "$result"
        case $rc in
            0) : ;;
            124) printf 'Query timed out after 20 seconds.\n' ;;
            *) printf 'smartctl returned status %s. The health result above may still be valid; check smartctl documentation for device-specific status details.\n' "$rc" ;;
        esac
    done < <(lsblk -dnpo NAME,TYPE 2>/dev/null)
    if ((count == 0)); then printf 'No whole-disk block devices were detected by lsblk.\n'; fi
    printf '\nThis runs a read-only health query (-H); it does not start a self-test.\n'
}
boot_kernel() { section_title "Running kernel and boot parameters"; uname -a; printf '\nKernel command line:\n'; if [[ -r /proc/cmdline ]]; then cat /proc/cmdline | redact; else printf 'unavailable\n'; fi; }
boot_files() { section_title "Files in /boot"; if [[ -d /boot ]]; then ls -lah /boot 2>&1 | redact; else printf '/boot not found.\n'; fi; }
boot_loader() {
    local efivar current entry loader_path manager="" f found=0 efi_file_re='File\(([^)]*)\)'
    section_title "Boot manager in use"
    if [[ -d /sys/firmware/efi ]]; then
        printf 'Firmware mode: UEFI\n'
        if have efibootmgr; then
            efivar=$(efibootmgr -v 2>&1)
            current=$(printf '%s\n' "$efivar" | sed -n 's/^BootCurrent: //p' | head -n 1)
            if [[ -n "$current" ]]; then
                entry=$(printf '%s\n' "$efivar" | grep -i "^Boot${current}[^:]*:" | head -n 1)
                printf 'Active firmware entry: %s\n' "${entry:-Boot$current (entry details unavailable)}" | redact
                if [[ "$entry" =~ $efi_file_re ]]; then loader_path=${BASH_REMATCH[1]}; fi
                case "${loader_path,,}" in
                    *grub*.efi*) manager=GRUB ;;
                    *elilo*.efi*) manager=ELILO ;;
                    *systemd-boot*.efi*|*systemd*.efi*) manager="systemd-boot" ;;
                    *refind*.efi*) manager=rEFInd ;;
                    *shim*.efi*) manager="shim (chain-loaded manager not identified from BootCurrent)" ;;
                    *lilo*.efi*) manager=LILO ;;
                esac
                [[ -n "$loader_path" ]] && printf 'Active EFI program: %s\n' "$loader_path" | redact
            else
                printf 'efibootmgr did not report BootCurrent; active manager could not be determined.\n'
            fi
        else
            printf 'Install efibootmgr and run as root to identify the active UEFI boot entry.\n'
        fi
    else
        printf 'Firmware mode: BIOS/Legacy\n'
        printf 'BIOS does not expose the active boot manager to the running OS through a standard interface.\n'
        printf 'Configuration files below are candidates and do not prove which manager booted this system.\n'
    fi

    if [[ "$manager" == "GRUB" ]]; then
        printf '\nConfiguration for the active manager (GRUB):\n'
        for f in /boot/grub/grub.cfg /boot/grub2/grub.cfg /boot/efi/EFI/Slackware/grub.cfg /boot/efi/EFI/slackware/grub.cfg /etc/default/grub; do
            [[ -r "$f" ]] || continue; found=1; printf '\n--- %s ---\n' "$f"
            grep -E '^[[:space:]]*(menuentry|submenu|linux|linuxefi|initrd|initrdefi|GRUB_DEFAULT|GRUB_TIMEOUT|GRUB_CMDLINE_LINUX|GRUB_DISABLE_OS_PROBER)' "$f" | head -n 200 | redact
        done
        ((found)) || printf 'GRUB is the active EFI program, but its configuration file was not found at the usual paths.\n'
    elif [[ "$manager" == "ELILO" ]]; then
        for f in /etc/elilo.conf /boot/efi/EFI/Slackware/elilo.conf /boot/efi/EFI/slackware/elilo.conf; do
            [[ -r "$f" ]] || continue; found=1; printf '\n--- %s ---\n' "$f"; awk '!/^[[:space:]]*#/ && NF' "$f" | redact
        done
        ((found)) || printf 'ELILO is active, but its configuration file was not found at the usual paths.\n'
    elif [[ "$manager" == "systemd-boot" ]]; then
        for f in /boot/loader/loader.conf /boot/efi/loader/loader.conf /boot/loader/entries/*.conf /boot/efi/loader/entries/*.conf; do
            [[ -r "$f" ]] || continue; found=1; printf '\n--- %s ---\n' "$f"; awk '!/^[[:space:]]*#/ && NF' "$f" | redact
        done
        ((found)) || printf 'systemd-boot is active, but loader configuration files were not found at the usual paths.\n'
    elif [[ "$manager" == "rEFInd" ]]; then
        for f in /boot/EFI/BOOT/refind.conf /boot/efi/EFI/BOOT/refind.conf /boot/efi/EFI/refind/refind.conf /boot/refind_linux.conf; do
            [[ -r "$f" ]] || continue; found=1; printf '\n--- %s ---\n' "$f"; awk '!/^[[:space:]]*#/ && NF' "$f" | head -n 200 | redact
        done
        ((found)) || printf 'rEFInd is active, but its configuration file was not found at the usual paths.\n'
    elif [[ -n "$manager" ]]; then
        printf '\nActive manager: %s. Its configuration could not be mapped automatically.\n' "$manager"
        printf 'EFI loader path: %s\n' "${loader_path:-unknown}"
    elif [[ ! -d /sys/firmware/efi ]]; then
        for f in /boot/grub/grub.cfg /boot/grub2/grub.cfg /etc/lilo.conf /etc/elilo.conf; do
            [[ -r "$f" ]] || continue; printf '\n--- candidate: %s ---\n' "$f"
            grep -E '^[[:space:]]*(image|initrd|root|append|label|menuentry|submenu|linux|linuxefi|timeout|default)' "$f" | head -n 160 | redact
        done
    fi
}
boot_uefi() { section_title "UEFI boot entries"; if [[ ! -d /sys/firmware/efi ]]; then printf 'System does not appear to be booted in UEFI mode.\n'; elif have efibootmgr && [[ $EUID -eq 0 ]]; then efibootmgr -v 2>&1 | redact; else printf 'Install efibootmgr and run as root to inspect UEFI entries.\n'; fi; }
network_interfaces() { section_title "Network interfaces and addresses"; if have ip; then ip -details address 2>&1 | redact; else printf 'iproute2 is not installed.\n'; fi; }
network_routes() { section_title "Network routes"; if have ip; then ip route show table all 2>&1 | redact; else printf 'iproute2 is not installed.\n'; fi; }
network_dns() { section_title "DNS configuration"; if [[ -r /etc/resolv.conf ]]; then cat /etc/resolv.conf | redact; else printf '/etc/resolv.conf unavailable.\n'; fi; if have nmcli; then printf '\nNetworkManager DNS:\n'; nmcli device show 2>&1 | grep -E 'GENERAL.DEVICE|IP[46].DNS|IP[46].DOMAIN' | redact; fi; }
network_wireless() { section_title "Wireless devices"; if have iw; then iw dev 2>&1 | redact; else printf 'iw is not installed.\n'; fi; if have nmcli; then printf '\nNetworkManager device status:\n'; nmcli device status 2>&1 | redact; fi; }
network_sockets() { section_title "Listening network sockets"; if have ss; then ss -lntup 2>&1 | redact; elif have netstat; then netstat -lntup 2>&1 | redact; else printf 'Install iproute2 (ss) or net-tools (netstat).\n'; fi; }
services_rc() { local f; section_title "Slackware startup scripts"; if [[ -d /etc/rc.d ]]; then for f in /etc/rc.d/rc.*; do [[ -f "$f" ]] || continue; if [[ -x "$f" ]]; then printf 'enabled  %s\n' "$f"; else printf 'disabled %s\n' "$f"; fi; done; else printf '/etc/rc.d not found.\n'; fi; }
services_processes() { section_title "Running processes"; if have ps; then ps -eo user,pid,ppid,stat,%cpu,%mem,comm,args --sort=-%cpu 2>&1 | head -n 200 | redact; else printf 'ps is unavailable.\n'; fi; }
