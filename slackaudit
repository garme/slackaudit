#!/bin/bash
# slackaudit - read-only local Slackware auditor

VERSION="0.2.5"
PROGRAM="slackaudit"
export LC_ALL=C
TMPDIR_AUDIT=""
DIALOG_BIN="${DIALOG:-dialog}"
REPORT_FILE=""
FORCE=0
PACKAGE_LOG_DIR="${SLACKAUDIT_PACKAGE_DIR:-/var/log/packages}"

have() { command -v "$1" >/dev/null 2>&1; }
cleanup() { [[ -n "$TMPDIR_AUDIT" && -d "$TMPDIR_AUDIT" ]] && rm -rf -- "$TMPDIR_AUDIT"; }
trap cleanup EXIT HUP INT TERM

usage() {
    cat <<USAGE
slackaudit $VERSION - local Slackware audit tool

Usage:
  slackaudit                 Open the dialog interface
  slackaudit --report FILE   Write a complete text report
  slackaudit --report FILE --force
  slackaudit --help
  slackaudit --version

For the most complete results, run the interactive interface as root (for example, sudo slackaudit).

This is a read-only audit. Package manifest checks only verify that files listed in
/var/log/packages exist; they do not compare hashes
or detect modified file contents. CVE analysis is not included.
USAGE
}

while (($#)); do
    case "$1" in
        --report|-r) (($# >= 2)) || { usage >&2; exit 2; }; REPORT_FILE=$2; shift 2 ;;
        --force|-f) FORCE=1; shift ;;
        --help|-h) usage; exit 0 ;;
        --version|-V) printf '%s %s\n' "$PROGRAM" "$VERSION"; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -z "$REPORT_FILE" ]] && ! have "$DIALOG_BIN"; then
    printf 'slackaudit: dialog not found. Install dialog or use --report FILE.\n' >&2
    exit 1
fi
TMPDIR_AUDIT=$(mktemp -d /tmp/slackaudit.XXXXXX) || exit 1
chmod 700 "$TMPDIR_AUDIT"

redact() {
    sed -E \
        -e '/(Serial Number|UUID|Asset Tag|Product Serial):/ s/:.*/: [redacted]/I' \
        -e 's/([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}/[MAC redacted]/g'
}
print_cmd() {
    local cmd=$1
    shift
    if have "$cmd"; then "$cmd" "$@" 2>&1 | redact
    else printf '[unavailable: command %s is not installed]\n' "$cmd"
    fi
}
section_title() {
    printf '%s\n' "$1"
    printf '%s\n' '========================================'
    printf '\n'
}

system_overview() {
    section_title "System overview"
    printf 'Hostname: %s\n' "$(hostname 2>/dev/null || printf unknown)"
    printf 'Slackware: '
    if [[ -r /etc/slackware-version ]]; then cat /etc/slackware-version; else printf 'version not identified\n'; fi
    printf 'Architecture: %s\n' "$(uname -m 2>/dev/null || printf unknown)"
    printf 'Kernel: %s\n' "$(uname -r 2>/dev/null || printf unknown)"
    printf 'Collection time: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z' 2>/dev/null || date)"
    if have uptime; then printf 'Uptime: '; uptime -p 2>/dev/null || uptime; fi
    if [[ -d /sys/firmware/efi ]]; then printf 'Firmware: UEFI\n'
    else printf 'Firmware: BIOS/Legacy or UEFI variables unavailable\n'; fi
    if [[ $EUID -eq 0 ]]; then printf 'Privileges: root\n'
    else printf 'Privileges: unprivileged; some data may be limited\n'; fi
    printf '\n'
    section_title "Resources"
    print_cmd free -h
    printf '\n'
    print_cmd df -hT /
}

hardware_cpu() {
    local lscpu_file="$TMPDIR_AUDIT/lscpu-cpu.out"
    section_title "CPU details"
    if have lscpu && lscpu > "$lscpu_file" 2>&1 && grep -q '^Architecture:' "$lscpu_file"; then
        awk -F: '
            BEGIN { IGNORECASE=0 }
            /^[[:space:]]*(Architecture|CPU\(s\)|On-line CPU\(s\) list|Vendor ID|Model name|CPU family|Model|Stepping|CPU MHz|CPU max MHz|CPU min MHz|BogoMIPS|Virtualization|Hypervisor vendor|Virtualization type|L[1-9][di] cache|NUMA node\(s\)|Flags):/ {print}
        ' "$lscpu_file" | redact
    elif [[ -r /proc/cpuinfo ]]; then
        printf 'lscpu is unavailable or incomplete; showing CPU fields from /proc/cpuinfo.\n'
        awk -F: '/^(vendor_id|cpu family|model|model name|stepping|cpu MHz|bogomips|flags|Features|Hardware|Processor)[[:space:]]*:/ {sub(/^[[:space:]]*/, "", $2); print $1 ": " $2}' /proc/cpuinfo | awk '!seen[$0]++' | redact
    else
        printf 'CPU details are unavailable.\n'
    fi
    printf '\nLogical processors: '
    if have nproc; then nproc
    elif [[ -r /proc/cpuinfo ]]; then grep -c '^processor[[:space:]]*:' /proc/cpuinfo 2>/dev/null || printf 'unavailable\n'
    else printf 'unavailable\n'; fi
}

hardware_pci() {
    section_title "PCI devices and drivers"
    if have lspci; then lspci -nnk 2>&1 | redact
    elif [[ -d /sys/bus/pci/devices ]]; then
        for d in /sys/bus/pci/devices/*; do
            [[ -e "$d" ]] || continue
            printf '%s vendor=%s device=%s class=%s driver=%s\n' \
                "$(basename "$d")" "$(cat "$d/vendor" 2>/dev/null)" "$(cat "$d/device" 2>/dev/null)" \
                "$(cat "$d/class" 2>/dev/null)" "$(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)"
        done
    else printf 'PCI information unavailable.\n'; fi
}

hardware_memory() {
    section_title "Memory"
    print_cmd free -h
    if [[ -r /proc/meminfo ]]; then printf '\n/proc/meminfo:\n'; cat /proc/meminfo; fi
    printf '\nMemory modules (optional: dmidecode):\n'
    if have dmidecode && [[ $EUID -eq 0 ]]; then dmidecode -t memory 2>&1 | redact
    elif have dmidecode; then printf 'Run as root to query memory-module details.\n'
    else printf 'dmidecode is not installed.\n'; fi
}

hardware_board() {
    section_title "Motherboard and firmware"
    if have dmidecode && [[ $EUID -eq 0 ]]; then dmidecode -t system -t baseboard -t bios 2>&1 | redact
    elif have dmidecode; then printf 'Run as root to query SMBIOS details.\n'
    else printf 'dmidecode is not installed.\n'; fi
}

hardware_graphics() {
    section_title "Graphics controllers"
    if have lspci; then lspci -nnk | grep -i -E -A4 'VGA compatible|3D controller|Display controller' | redact || printf 'No graphics controller listed.\n'
    else printf 'Install pciutils to identify graphics controllers.\n'; fi
}
hardware_audio() {
    section_title "Audio devices"
    if have aplay; then aplay -l 2>&1 | redact; else printf 'alsa-utils (aplay) is not installed.\n'; fi
    if have lspci; then printf '\nPCI audio devices:\n'; lspci -nnk | grep -i -E -A4 'Audio device|Multimedia audio' | redact || true; fi
}
hardware_input() {
    section_title "Input devices"
    if have libinput; then libinput list-devices 2>&1 | redact
    elif have lsinput; then lsinput 2>&1 | redact
    else printf 'Install libinput (or a package providing lsinput) for detailed device information.\n'; fi
    if [[ -r /proc/bus/input/devices ]]; then printf '\nKernel input-device list:\n'; cat /proc/bus/input/devices | redact; fi
}
hardware_sensors() {
    section_title "Hardware sensors"
    if have sensors; then sensors 2>&1 | redact
    else printf 'lm_sensors is not installed or sensors are not configured.\n'; fi
}

hardware_modules() {
    section_title "Loaded kernel modules"
    if have lsmod; then
        lsmod 2>&1 | redact
    elif [[ -r /proc/modules ]]; then
        printf 'lsmod is unavailable; reading /proc/modules.\n'
        printf 'Module                 Size  Used by\n'
        awk '{printf "%-22s %8s %4s %s\n", $1, $2, $3, $4}' /proc/modules | redact
    else
        printf 'Loaded module information is unavailable.\n'
    fi
    if [[ -r /proc/sys/kernel/modules_disabled ]]; then
        printf '\nModule loading disabled: '
        case "$(cat /proc/sys/kernel/modules_disabled 2>/dev/null)" in
            1) printf 'yes\n' ;; 0) printf 'no\n' ;; *) printf 'unknown\n' ;;
        esac
    fi
}

hardware_usb() {
    section_title "USB devices"
    if have lsusb; then
        printf 'Bus tree and speed:\n'; lsusb -t 2>&1 | redact
        printf '\nDevices:\n'; lsusb 2>&1 | redact
    elif [[ -d /sys/bus/usb/devices ]]; then
        for d in /sys/bus/usb/devices/*; do
            [[ -r "$d/idVendor" ]] || continue
            printf '%s %s:%s %s %s\n' "$(basename "$d")" "$(cat "$d/idVendor")" "$(cat "$d/idProduct")" \
                "$(cat "$d/manufacturer" 2>/dev/null)" "$(cat "$d/product" 2>/dev/null)"
        done
    else printf 'USB information unavailable.\n'; fi
}

hardware_storage() {
    local lsblk_file="$TMPDIR_AUDIT/lsblk.out"
    section_title "Disks and partitions"
    if have lsblk; then
        if lsblk -e 7 -o NAME,TYPE,SIZE,FSTYPE,LABEL,UUID,MODEL > "$lsblk_file" 2>&1; then
            redact < "$lsblk_file"
        else
            printf 'lsblk failed; falling back to /proc/partitions. Diagnostic:\n'
            sed -n '1,5p' "$lsblk_file" | redact
            if [[ -r /proc/partitions ]]; then cat /proc/partitions; else printf 'Partition table information unavailable.\n'; fi
        fi
    elif [[ -r /proc/partitions ]]; then
        printf 'lsblk is not installed; showing kernel partition records.\n'
        cat /proc/partitions
    else
        printf 'Disk and partition information is unavailable.\n'
    fi
    printf '\nMount points are listed separately in the Mounted filesystems screen.\n'
}

hardware_graphics_audio_input() {
    section_title "Graphics"
    if have lspci; then lspci -nnk 2>/dev/null | grep -i -E -A3 'VGA compatible|3D controller|Display controller' | redact || printf 'No graphics controller listed.\n'
    else printf 'Install pciutils to identify PCI controllers.\n'; fi
    printf '\n'
    section_title "Audio"
    if have aplay; then aplay -l 2>&1 | redact; else printf 'aplay is not installed.\n'; fi
    if have lspci; then lspci -nnk 2>/dev/null | grep -i -E -A3 'Audio device|Multimedia audio' | redact || true; fi
    printf '\n'
    section_title "Input devices"
    if have libinput; then libinput list-devices 2>&1 | redact
    elif have lsinput; then lsinput 2>&1 | redact
    else printf 'libinput/lsinput is not installed; detailed device list is unavailable.\n'; fi
    printf '\n'
    section_title "Sensors"
    if have sensors; then sensors 2>&1 | redact
    else printf 'lm_sensors is not installed or sensors are not configured.\n'; fi
}

hardware_network() {
    section_title "Network adapters"
    if have lspci; then lspci -nnk 2>/dev/null | grep -i -E -A3 'Ethernet controller|Network controller|Wireless' | redact || true; fi
    printf '\nInterfaces and addresses:\n'
    if have ip; then ip -brief address 2>&1 | redact; else printf 'iproute2 is not installed.\n'; fi
    printf '\nRoutes:\n'
    if have ip; then ip route 2>&1 | redact; fi
    printf '\nWi-Fi:\n'
    if have iw; then iw dev 2>&1 | redact; else printf 'iw is not installed.\n'; fi
}
hardware_all() {
    hardware_cpu; hardware_memory; hardware_board; hardware_modules
    hardware_pci; hardware_usb; hardware_storage
    hardware_graphics_audio_input; hardware_network
}

audit_summary() {
    local f name base count=0 dupcount=0 rc_enabled=0 used="" dmesg_file="$TMPDIR_AUDIT/summary-dmesg"
    local dupfile="$TMPDIR_AUDIT/summary-duplicates"
    : > "$dupfile"
    section_title "Local audit summary"
    printf 'System: %s | architecture: %s | kernel: %s\n' \
        "$(cat /etc/slackware-version 2>/dev/null || printf unknown)" \
        "$(uname -m 2>/dev/null || printf unknown)" "$(uname -r 2>/dev/null || printf unknown)"
    if [[ $EUID -eq 0 ]]; then printf 'Access: OK - running as root.\n'
    else printf 'Access: LIMITED - unprivileged; some checks may be incomplete.\n'; fi

    if [[ -d "$PACKAGE_LOG_DIR" ]]; then
        shopt -s nullglob
        local pkgs=("$PACKAGE_LOG_DIR"/*)
        shopt -u nullglob
        for f in "${pkgs[@]}"; do
            [[ -f "$f" ]] || continue
            name=$(sed -n 's/^PACKAGE NAME: //p' "$f" | head -n 1)
            [[ -n "$name" ]] || name=$(basename "$f")
            base=$(printf '%s\n' "$name" | sed -E 's/-[^-]+-[^-]+-[^-]+$//')
            printf '%s\n' "$base" >> "$dupfile"
            ((count+=1))
        done
        dupcount=$(sort "$dupfile" | uniq -d | wc -l)
        printf 'Registered packages: %s\n' "$count"
        if ((dupcount)); then printf 'Duplicate package names: ATTENTION - %s name(s).\n' "$dupcount"
        else printf 'Duplicate package names: OK - none found.\n'; fi
    else printf 'Packages: ATTENTION - package database directory not found: %s\n' "$PACKAGE_LOG_DIR"; fi

    if have findmnt && [[ -r /etc/fstab ]]; then
        if findmnt --verify --tab-file /etc/fstab >/dev/null 2>&1; then
            printf '/etc/fstab: OK - structural check passed.\n'
        else
            printf '/etc/fstab: ATTENTION - findmnt reported issues; see the storage section.\n'
        fi
    else printf '/etc/fstab: NOT CHECKED - findmnt or the file is unavailable.\n'; fi

    if have df; then
        used=$(df -P / 2>/dev/null | awk 'NR==2 {gsub(/%/, "", $5); print $5}')
        if [[ "$used" =~ ^[0-9]+$ ]]; then
            if ((used >= 95)); then printf 'Root filesystem usage: FAIL - %s%% used.\n' "$used"
            elif ((used >= 85)); then printf 'Root filesystem usage: ATTENTION - %s%% used.\n' "$used"
            else printf 'Root filesystem usage: OK - %s%% used.\n' "$used"; fi
        else printf 'Root filesystem usage: NOT CHECKED.\n'; fi
    fi

    if [[ -d /etc/rc.d ]]; then
        for f in /etc/rc.d/rc.*; do [[ -f "$f" && -x "$f" ]] && ((rc_enabled+=1)); done
        printf 'Enabled rc scripts: %s (review whether each is needed).\n' "$rc_enabled"
    fi
    if have dmesg; then
        if dmesg > "$dmesg_file" 2>&1; then
            count=$(grep -i -E 'error|failed|failure|firmware.*(missing|not found)|timeout|I/O error|Call Trace' "$dmesg_file" | wc -l)
            if ((count)); then printf 'Kernel messages to review: ATTENTION - %s matching line(s) in the current buffer.\n' "$count"
            else printf 'Kernel messages: OK - no matching error pattern in the current buffer.\n'; fi
        else
            printf 'Kernel messages: NOT CHECKED - dmesg access failed.\n'
            sed -n '1,3p' "$dmesg_file"
        fi
    else printf 'Kernel messages: NOT CHECKED - dmesg is not installed.\n'; fi
    printf '\nThis summary uses simple local checks; it does not assign an overall score or scan CVEs.\n'
}

package_audit() {
    local f n base total=0 checked=0 missing=0
    local dupfile="$TMPDIR_AUDIT/duplicates" missingfile="$TMPDIR_AUDIT/missing"
    : > "$dupfile"; : > "$missingfile"
    section_title "Installed packages"
    if [[ ! -d "$PACKAGE_LOG_DIR" ]]; then printf 'Package database directory not found: %s\n' "$PACKAGE_LOG_DIR"; return; fi
    shopt -s nullglob
    local files=("$PACKAGE_LOG_DIR"/*)
    shopt -u nullglob
    printf 'Package records: %s\n' "${#files[@]}"
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        n=$(sed -n 's/^PACKAGE NAME: //p' "$f" | head -n 1)
        [[ -n "$n" ]] || n=$(basename "$f")
        base=$(printf '%s\n' "$n" | sed -E 's/-[^-]+-[^-]+-[^-]+$//')
        printf '%s\n' "$base" >> "$dupfile"
        ((total+=1))
    done
    printf 'Package names with multiple installed versions:\n'
    if sort "$dupfile" | uniq -d | grep .; then :; else printf 'None found.\n'; fi
    printf '\nPresence of files listed in package manifests:\n'
    printf 'This check does not compare file contents or hashes.\n'
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        while IFS= read -r n; do
            [[ -n "$n" ]] || continue
            [[ "$n" == install/* || "$n" == ./install/* ]] && continue
            case "$n" in ./*) n=${n#./} ;; esac
            [[ "$n" == /* ]] || n="/$n"
            ((checked+=1))
            if [[ ! -e "$n" && ! -L "$n" ]]; then
                ((missing+=1))
                if ((missing <= 100)); then printf '%s: %s\n' "$(basename "$f")" "$n" >> "$missingfile"; fi
            fi
        done < <(awk 'BEGIN{list=0} /^FILE LIST:/{list=1; next} list{print}' "$f")
    done
    printf 'Entries checked: %s\nMissing files: %s\n' "$checked" "$missing"
    if ((missing)); then printf 'First missing paths (maximum 100):\n'; cat "$missingfile"; fi
    printf '\nPackage records are stored in %s.\n' "$PACKAGE_LOG_DIR"
    printf 'The tool does not automatically classify packages as official or third-party.\n'
}

storage_audit() {
    section_title "Storage and filesystems"
    hardware_storage
    storage_mounts
    printf '\n/etc/fstab check:\n'
    if have findmnt; then findmnt --verify --verbose --tab-file /etc/fstab 2>&1 | redact
    else printf 'findmnt is unavailable; review devices and UUIDs manually.\n'; fi
    printf '\nDisk usage:\n'; print_cmd df -hT
    printf '\nInodes:\n'; print_cmd df -hi
    storage_smart
}

boot_audit() {
    section_title "Running kernel"
    printf 'uname -a: '; uname -a
    printf '\nKernel command line:\n'
    if [[ -r /proc/cmdline ]]; then cat /proc/cmdline | redact; else printf 'unavailable\n'; fi
    printf '\nFiles in /boot:\n'
    if [[ -d /boot ]]; then ls -lah /boot 2>&1 | redact; else printf '/boot not found.\n'; fi
    printf '\n'
    boot_loader
    if [[ -d /sys/firmware/efi ]]; then printf '\n'; boot_uefi; fi
}

network_audit() {
    section_title "Network"
    printf 'Interfaces and addresses:\n'
    if have ip; then ip -brief address 2>&1 | redact; else printf 'iproute2 is not installed.\n'; fi
    printf '\nRoutes:\n'; if have ip; then ip route 2>&1 | redact; fi
    printf '\nConfigured DNS:\n'
    if [[ -r /etc/resolv.conf ]]; then cat /etc/resolv.conf | redact; else printf '/etc/resolv.conf unavailable.\n'; fi
    printf '\nNetworkManager:\n'
    if have nmcli; then nmcli general status 2>&1 | redact; nmcli device status 2>&1 | redact
    else printf 'nmcli is not installed.\n'; fi
    printf '\nListening sockets:\n'
    if have ss; then ss -lntup 2>&1 | redact
    elif have netstat; then netstat -lntup 2>&1 | redact
    else printf 'ss/netstat unavailable.\n'; fi
}

services_audit() {
    local f
    section_title "Slackware startup services"
    printf 'Executable scripts in /etc/rc.d (executable bit = enabled):\n'
    if [[ -d /etc/rc.d ]]; then
        for f in /etc/rc.d/rc.*; do
            [[ -f "$f" ]] || continue
            if [[ -x "$f" ]]; then printf 'enabled      %s\n' "$f"; else printf 'disabled     %s\n' "$f"; fi
        done
    else printf '/etc/rc.d not found.\n'; fi
    printf '\nProcesses (short list):\n'
    if have ps; then ps -eo pid,comm,args --sort=comm 2>&1 | head -n 100 | redact
    else printf 'ps is unavailable.\n'; fi
    printf '\nListening sockets:\n'
    if have ss; then ss -lntup 2>&1 | redact; else printf 'ss is unavailable.\n'; fi
}

security_audit() {
    local f
    section_title "Local accounts"
    if [[ -r /etc/passwd ]]; then
        awk -F: '$3==0 || $3>=1000 {printf "%-20s uid=%-6s gid=%-6s home=%s shell=%s\n",$1,$3,$4,$6,$7}' /etc/passwd
    fi
    printf '\nRelevant administrative groups:\n'
    if [[ -r /etc/group ]]; then grep -E '^(wheel|sudo|root):' /etc/group || printf 'No matching groups found.\n'; fi
    printf '\nPermissions of sensitive files:\n'
    for f in /etc/passwd /etc/shadow /etc/group /etc/sudoers /etc/ssh/sshd_config; do
        [[ -e "$f" ]] || continue
        stat -c '%A %a %U:%G %n' "$f" 2>&1
    done
    printf '\n'
    security_ssh
    printf '\nFirewall:\n'
    if have nft; then nft list ruleset 2>&1 | head -n 160 | redact
    elif have iptables; then iptables -S 2>&1 | redact
    else printf 'nftables/iptables unavailable.\n'; fi
    printf '\nLocal configuration checks only; CVE analysis is not included.\n'
}

logs_audit() {
    section_title "Categorized log review"
    printf 'Kernel message categories:\n'
    logs_kernel
    printf '\nSystem log categories:\n'
    logs_files
    printf '\nCategories are heuristic text matches; review context before drawing conclusions.\n'
}

# Topic-level views used by the interactive submenus.
package_summary() {
    section_title "Installed package summary"
    if [[ ! -d "$PACKAGE_LOG_DIR" ]]; then printf 'Package database directory not found: %s\n' "$PACKAGE_LOG_DIR"; return; fi
    local f n base count=0
    local list="$TMPDIR_AUDIT/pkg-names"
    : > "$list"
    shopt -s nullglob; local files=("$PACKAGE_LOG_DIR"/*); shopt -u nullglob
    printf 'Package records: %s\n' "${#files[@]}"
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        n=$(sed -n 's/^PACKAGE NAME: //p' "$f" | head -n 1); [[ -n "$n" ]] || n=$(basename "$f")
        base=$(printf '%s\n' "$n" | sed -E 's/-[^-]+-[^-]+-[^-]+$//'); printf '%s\n' "$base" >> "$list"
    done
    printf '\nPackage names with multiple installed versions:\n'
    if sort "$list" | uniq -d | grep .; then :; else printf 'None found.\n'; fi
}
package_third_party() {
    section_title "Likely third-party packages"
    if [[ ! -d "$PACKAGE_LOG_DIR" ]]; then printf 'Package database directory not found: %s\n' "$PACKAGE_LOG_DIR"; return; fi
    local f n build lower count=0 list="$TMPDIR_AUDIT/third-party-packages"
    : > "$list"
    shopt -s nullglob; local files=("$PACKAGE_LOG_DIR"/*); shopt -u nullglob
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        n=$(sed -n 's/^PACKAGE NAME: //p' "$f" | head -n 1)
        [[ -n "$n" ]] || n=$(basename "$f")
        # Community repositories commonly mark packages with a maintainer or
        # repository tag in the build field (for example, _SBo or alien).
        if [[ "$n" =~ ^(.+)-[^-]+-[^-]+-([^-]+)$ ]]; then
            build=${BASH_REMATCH[2]}
            lower=${build,,}
            case "$lower" in
                *sbo*|*slackbuild*|*alien*|*ponce*|*restricted*|*slackonly*|*slackpkgplus*|*rlw*|*ktown*|*msb*|*gds*)
                    printf '%s\n' "$n" >> "$list"
                    ((count+=1))
                    ;;
            esac
        fi
    done
    printf 'Likely third-party packages found: %s\n\n' "$count"
    if ((count)); then sort -f "$list"; else printf 'No package records with recognized third-party build tags were found.\n'; fi
    printf '\nClassification uses recognizable repository or maintainer tags in package build names. Untagged local or third-party packages may not be detected; this list is indicative, not a complete provenance database.\n'
}
package_list() {
    section_title "Complete installed package list"
    if [[ ! -d "$PACKAGE_LOG_DIR" ]]; then printf 'Package database directory not found: %s\n' "$PACKAGE_LOG_DIR"; return; fi
    local f name list="$TMPDIR_AUDIT/installed-packages.sorted"
    : > "$list"
    shopt -s nullglob
    local files=("$PACKAGE_LOG_DIR"/*)
    shopt -u nullglob
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        name=$(sed -n 's/^PACKAGE NAME: //p' "$f" | head -n 1)
        [[ -n "$name" ]] || name=$(basename "$f")
        printf '%s\n' "$name" >> "$list"
    done
    if [[ ! -s "$list" ]]; then
        printf 'No package records found in %s.\n' "$PACKAGE_LOG_DIR"
        return
    fi
    printf 'Installed package records: %s\n\n' "$(wc -l < "$list" | tr -d ' ')"
    sort -f "$list"
}
requirement_check() {
    local package=$1 purpose=$2 cmd missing=""
    shift 2
    for cmd in "$@"; do
        have "$cmd" || missing+=" $cmd"
    done
    if [[ -z "$missing" ]]; then
        printf '[available] %-18s %s\n' "$package" "$purpose"
    else
        printf '[install %-18s] %s (missing command:%s)\n' "$package" "$purpose" "$missing"
    fi
}
requirement_any_check() {
    local package=$1 purpose=$2 cmd
    shift 2
    for cmd in "$@"; do
        if have "$cmd"; then
            printf '[available] %-18s %s (%s)\n' "$package" "$purpose" "$cmd"
            return
        fi
    done
    printf '[install %-18s] %s (missing commands:' "$package" "$purpose"
    printf ' %s' "$@"
    printf ')\n'
}
requirement_optional_check() {
